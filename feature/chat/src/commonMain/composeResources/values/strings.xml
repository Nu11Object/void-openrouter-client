    <string name="tune_temperature_title">Temperature</string>
    <string name="tune_temperature_desc">Controls randomness. Lower values make answers focused and repeatable, higher values make them more varied and creative.</string>
    <string name="tune_top_p_title">Top P</string>
    <string name="tune_top_p_desc">Limits choices to the smallest group of tokens whose combined probability reaches this value. Lower values keep the model on the most likely words.</string>
    <string name="tune_top_k_title">Top K</string>
    <string name="tune_top_k_desc">Limits choices to the K most likely tokens at each step. 0 turns the limit off.</string>
    <string name="tune_frequency_penalty_title">Frequency penalty</string>
    <string name="tune_frequency_penalty_desc">Discourages tokens in proportion to how often they have already appeared. Positive values reduce repetition, negative values encourage it.</string>
    <string name="tune_presence_penalty_title">Presence penalty</string>
    <string name="tune_presence_penalty_desc">Discourages tokens that have appeared at least once, no matter how often. Positive values push the model toward new topics.</string>
    <string name="tune_repetition_penalty_title">Repetition penalty</string>
    <string name="tune_repetition_penalty_desc">Reduces repetition of tokens from the input. 1 means no effect, values above 1 penalize repeats, values below 1 encourage them.</string>
    <string name="tune_max_tokens_title">Max tokens</string>
    <string name="tune_max_tokens_desc">Upper limit on the response length. With thinking enabled, the limit also covers reasoning tokens, so a small value can leave the answer empty.</string>
    <string name="tune_seed_title">Seed</string>
    <string name="tune_seed_desc">Makes generation repeatable: the same seed and settings should give the same result. Not guaranteed for every model.</string>

